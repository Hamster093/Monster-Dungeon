        "D:/unity试水项目/Monster-Dungeon/Assets/Scripts/UI/Panel/RouteSelectionPanel.cs:124"
      ],
      "main": [
        "接取委托后，你需要向冒险者进行指路。",
        "你可以点击魔物占用的格子，并在详情中确认指路。"
      ],
      "mainIds": [
        "route.main.01",
        "route.main.02"
      ],
      "details": [
